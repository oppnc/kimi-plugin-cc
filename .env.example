# Optional environment for kimi-plugin-cc (copy to .env only if your host loads it).
# Prefer setting these in the host shell / process environment.

# Absolute path to the Kimi CLI binary (kimi / kimi.exe)
# KIMI_CLI_PATH=

# Job store directory (default: ~/.kimi-plugin-cc)
# KIMI_PLUGIN_CC_DATA_DIR=

# Best-effort host session scoping (usually injected by Claude Code / Grok)
# CLAUDE_SESSION_ID=
# GROK_SESSION_ID=
# KIMI_PLUGIN_CC_HOST_SESSION=
